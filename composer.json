{
    "name": "conquer/jvectormap",
    "description": "jVectorMap widget for Yii2 with the bundled world, continent and country maps",
    "keywords": [
        "yii2",
        "extension",
        "widget",
        "jvectormap"
    ],
    "homepage": "https://github.com/borodulin/yii2-jvectormap",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-jvectormap/issues",
        "source": "https://github.com/borodulin/yii2-jvectormap"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.2.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "conquer\\jvectormap\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\jvectormap\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
